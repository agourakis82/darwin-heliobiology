// sio/omni.sio — parser OMNI2 .dat (spec §2).
//
// Colunas 0-idx: 0 ano, 1 doy, 2 hora, 12 Bx, 15 By, 16 Bz GSM, 23 n, 24 v, 28 pressao,
// 38 Kp*10, 40 Dst. Fills 999.9 / 9999 / 99.99 / 99 / 99999 -> AUSENTE.
// Kp / 10 na leitura. Ausente NUNCA vira 0: cada campo tem um bit de validade em `m`.
//
// Registro i: t[i] (segundos UTC), 8 colunas f64 em f[col*cap + i], mascara de validade m[i]
// (bit `col` = 1 quando o valor existe). Memoria no heap (52 608 x 8 f64 ~ 3.4 MB).

use num::{NumOut, Tok, parse_dec, parse_int_tok, find_nl, next_tok, days_from_civil, min_f64, max_f64, print_tok, print_tok_opt}

pub fn col_bx() -> i64 { 0 }
pub fn col_by() -> i64 { 1 }
pub fn col_bz() -> i64 { 2 }
pub fn col_n() -> i64 { 3 }
pub fn col_v() -> i64 { 4 }
pub fn col_p() -> i64 { 5 }
pub fn col_kp() -> i64 { 6 }
pub fn col_dst() -> i64 { 7 }

pub struct Omni {
    pub n: i64,
    pub cap: i64,
    pub f: i64,
    pub t: i64,
    pub m: i64,
    pub bad: i64,
}

pub fn omni_new(cap: i64) -> Omni with Alloc, Mut, Panic, Div {
    var c = cap
    if c < 1 { c = 1 }
    let f = heap_alloc(8 * 8 * c) as *mut f64
    let t = heap_alloc(8 * c) as *mut i64
    let m = heap_alloc(8 * c) as *mut i64
    Omni { n: 0, cap: c, f: f as i64, t: t as i64, m: m as i64, bad: 0 }
}

pub fn omni_t(o: &Omni, i: i64) -> i64 with Mut, Panic, Div {
    let p = o.t as *mut i64
    read_i64(p, i)
}

pub fn omni_valid(o: &Omni, col: i64, i: i64) -> bool with Mut, Panic, Div {
    let p = o.m as *mut i64
    let m = read_i64(p, i)
    ((m >> col) & 1) == 1
}

pub fn omni_get(o: &Omni, col: i64, i: i64) -> f64 with Mut, Panic, Div {
    let p = o.f as *mut f64
    read_f64(p, col * o.cap + i)
}

// Quantas linhas nao vazias ha (limite superior da capacidade necessaria).
pub fn omni_count_lines(path: string) -> i64 with IO, Mut, Panic, Div {
    let s = read_file(path)
    let n = str_len(s)
    var cnt: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char_at(s, i) == 10 { cnt = cnt + 1 }
        i = i + 1
    }
    cnt + 1
}

// Coluna 0-idx do arquivo -> slot: 0..7 = variaveis; 100/101/102 = ano/doy/hora; -1 = ignorar.
fn slot_of(k: i64) -> i64 {
    if k == 0 { return 100 }
    if k == 1 { return 101 }
    if k == 2 { return 102 }
    if k == 12 { return 0 }
    if k == 15 { return 1 }
    if k == 16 { return 2 }
    if k == 23 { return 3 }
    if k == 24 { return 4 }
    if k == 28 { return 5 }
    if k == 38 { return 6 }
    if k == 40 { return 7 }
    -1
}

fn fill_of(slot: i64) -> f64 {
    if slot == 4 { return 9999.0 }
    if slot == 5 { return 99.99 }
    if slot == 6 { return 99.0 }
    if slot == 7 { return 99999.0 }
    999.9
}

// Acrescenta os registros de um arquivo. Retorna o numero de registros acrescentados.
pub fn omni_append_file(o: &!Omni, path: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    let s = read_file(path)
    let n = str_len(s)
    var pos: i64 = 0
    var added: i64 = 0
    var tk = Tok { a: 0, b: 0 }
    var num = NumOut { v: 0.0, ok: 0 }
    let fp = o.f as *mut f64
    let tp = o.t as *mut i64
    let mp = o.m as *mut i64
    while pos < n {
        let le = find_nl(s, n, pos)
        var cur = pos
        var k: i64 = 0
        var year: i64 = 0
        var doy: i64 = 0
        var hour: i64 = 0
        var head_ok: i64 = 1
        var mask: i64 = 0
        var vals: [f64; 8] = [0.0; 8]
        var any_tok = false
        while next_tok(s, &!cur, le, &!tk) {
            any_tok = true
            let slot = slot_of(k)
            if slot >= 100 {
                var iok: i64 = 0
                let iv = parse_int_tok(s, tk.a, tk.b, &!iok)
                if iok == 0 { head_ok = 0 }
                if slot == 100 { year = iv }
                if slot == 101 { doy = iv }
                if slot == 102 { hour = iv }
            } else {
                if slot >= 0 {
                    parse_dec(s, tk.a, tk.b, &!num)
                    if num.ok == 1 {
                        if num.v < fill_of(slot) {
                            if slot == 6 {
                                vals[slot as usize] = num.v / 10.0
                            } else {
                                vals[slot as usize] = num.v
                            }
                            mask = mask | (1 << slot)
                        }
                    }
                }
            }
            k = k + 1
        }
        if any_tok {
            if k < 41 || head_ok == 0 {
                o.bad = o.bad + 1
            } else {
                if o.n >= o.cap {
                    print("OMNI_CAPACITY_EXCEEDED\n")
                    return added
                }
                let i = o.n
                let days = days_from_civil(year, 1, 1) + doy - 1
                write_i64(tp, i, days * 86400 + hour * 3600)
                write_i64(mp, i, mask)
                var c: i64 = 0
                while c < 8 {
                    write_f64(fp, c * o.cap + i, vals[c as usize])
                    c = c + 1
                }
                o.n = o.n + 1
                added = added + 1
            }
        }
        pos = le + 1
    }
    added
}

// Resumo do spec §2: n_records, bad_lines, t_first, t_last e por variavel count/sum/min/max/wsum.
pub fn omni_print_summary(o: &Omni) with IO, Mut, Panic, Div {
    print("n_records "); print_int(o.n); print("\n")
    print("bad_lines "); print_int(o.bad); print("\n")
    if o.n > 0 {
        print("t_first "); print_int(omni_t(o, 0)); print("\n")
        print("t_last "); print_int(omni_t(o, o.n - 1)); print("\n")
    }
    var c: i64 = 0
    while c < 8 {
        var name = "bx"
        if c == 1 { name = "by" }
        if c == 2 { name = "bz" }
        if c == 3 { name = "n" }
        if c == 4 { name = "v" }
        if c == 5 { name = "p" }
        if c == 6 { name = "kp" }
        if c == 7 { name = "dst" }
        var cnt: i64 = 0
        var sum: f64 = 0.0
        var wsum: f64 = 0.0
        var mn: f64 = 0.0
        var mx: f64 = 0.0
        var i: i64 = 0
        while i < o.n {
            if omni_valid(o, c, i) {
                let x = omni_get(o, c, i)
                if cnt == 0 { mn = x; mx = x } else { mn = min_f64(mn, x); mx = max_f64(mx, x) }
                sum = sum + x
                wsum = wsum + x * ((i % 7 + 1) as f64)
                cnt = cnt + 1
            }
            i = i + 1
        }
        print("count "); print(name); print(" "); print_int(cnt); print("\n")
        print("sum "); print(name); print(" "); print_tok_opt(if cnt > 0 { 1 } else { 0 }, sum); print("\n")
        print("min "); print(name); print(" "); print_tok_opt(if cnt > 0 { 1 } else { 0 }, mn); print("\n")
        print("max "); print(name); print(" "); print_tok_opt(if cnt > 0 { 1 } else { 0 }, mx); print("\n")
        print("wsum "); print(name); print(" "); print_tok_opt(if cnt > 0 { 1 } else { 0 }, wsum); print("\n")
        c = c + 1
    }
}
