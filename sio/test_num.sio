// Testes de sio/num.sio: parse decimal, token exato, calendário, lexer.
use num::{parse_dec, NumOut, print_tok, days_from_civil, civil_from_days, Ymd, next_tok, Tok, find_nl, tok_is, parse_int_tok}

fn near(a: f64, b: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    d <= 0.0
}

fn chk_parse(txt: string, want: f64, want_ok: i64) -> bool with Mut, Div, Panic, Alloc {
    var o = NumOut { v: 0.0, ok: 0 }
    parse_dec(txt, 0, str_len(txt), &!o)
    if o.ok != want_ok { return false }
    if want_ok == 0 { return true }
    near(o.v, want)
}

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    // decimais (comparados BIT a BIT com o literal do compilador)
    assert(chk_parse("420", 420.0, 1))
    assert(chk_parse("-4.1", -4.1, 1))
    assert(chk_parse("+999.9", 999.9, 1))
    assert(chk_parse("0.05", 0.05, 1))
    assert(chk_parse("-1.0568900e+001", -10.5689, 1))
    assert(chk_parse("1.5e-3", 0.0015, 1))
    assert(chk_parse("6.1", 6.1, 1))
    assert(chk_parse("123456789.123", 123456789.123, 1))
    assert(chk_parse("abc", 0.0, 0))
    assert(chk_parse("", 0.0, 0))
    assert(chk_parse("1e", 0.0, 0))
    assert(chk_parse("1.2.3", 0.0, 0))
    assert(chk_parse("-", 0.0, 0))
    // calendário
    assert(days_from_civil(1970, 1, 1) == 0)
    assert(days_from_civil(2020, 1, 1) == 18262)
    assert(days_from_civil(2024, 3, 1) - days_from_civil(2024, 2, 28) == 2)  // 2024 é bissexto
    var ymd = Ymd { y: 0, m: 0, d: 0 }
    civil_from_days(18262 + 59, &!ymd)   // 2020-02-29
    assert(ymd.y == 2020 && ymd.m == 2 && ymd.d == 29)
    civil_from_days(days_from_civil(2025, 12, 31), &!ymd)
    assert(ymd.y == 2025 && ymd.m == 12 && ymd.d == 31)
    // lexer
    let s = "KP 100 NA # comentario\nDST 5 -3.5\n"
    let n = str_len(s)
    var pos: i64 = 0
    var t = Tok { a: 0, b: 0 }
    let le = find_nl(s, n, pos)
    assert(le == 22)
    assert(next_tok(s, &!pos, le, &!t))
    assert(tok_is(s, &t, "KP"))
    assert(next_tok(s, &!pos, le, &!t))
    var ok: i64 = 0
    assert(parse_int_tok(s, t.a, t.b, &!ok) == 100 && ok == 1)
    assert(next_tok(s, &!pos, le, &!t))
    assert(tok_is(s, &t, "NA"))
    assert(!next_tok(s, &!pos, le, &!t))   // comentário
    // tokens exatos (impressão visual conferida pela saída esperada)
    print_tok(1.0); print("\n")
    print_tok(-0.5); print("\n")
    print_tok(3.0); print("\n")
    print_tok(0.0); print("\n")
    print_tok(1.0e-300); print("\n")
    print("NUM_OK\n")
    return 0
}
