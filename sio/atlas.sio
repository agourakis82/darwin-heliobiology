// sio/atlas.sio — assinaturas geomagneticas diaria / mensal / trimestral (spec §5). PRINCIPAL.
//
// Varredura unica sobre registros em ordem cronologica: o periodo corrente e fechado quando
// a chave (ano, mes/trimestre, dia) muda. storm_hours = horas com Kp >= 5 (so Kp validos);
// valid_hours = horas com Kp valido, logo storm_hours <= valid_hours. Medias/minimos sem
// nenhuma amostra valida ficam AUSENTES (bit de validade 0): nunca 0.

use num::{civil_from_days, Ymd}
use omni::{Omni, omni_t, omni_valid, omni_get, col_bz, col_kp, col_dst}
use atlas_case::{AtlasRes, atlas_push}

// chave de periodo: devolve (ano, sub, dia) conforme a resolucao
fn period_key(t: i64, res: i64, ymd: &!Ymd) with Mut, Panic, Div {
    civil_from_days(t / 86400, ymd)
    if res == 1 { ymd.d = 0 }
    if res == 2 { ymd.m = (ymd.m - 1) / 3 + 1; ymd.d = 0 }
}

pub fn atlas_build(o: &Omni, res: i64, out: &!AtlasRes) with Mut, Panic, Div, Alloc {
    var ymd = Ymd { y: 0, m: 0, d: 0 }
    var cy: i64 = 0
    var cs: i64 = 0
    var cd: i64 = 0
    var open = false
    var nk: i64 = 0
    var ks: f64 = 0.0
    var storm: i64 = 0
    var nd: i64 = 0
    var ds: f64 = 0.0
    var dmin: f64 = 0.0
    var nb: i64 = 0
    var bs: f64 = 0.0
    var bneg: i64 = 0
    var i: i64 = 0
    while i < o.n {
        period_key(omni_t(o, i), res, &!ymd)
        if !open || ymd.y != cy || ymd.m != cs || ymd.d != cd {
            if open {
                var mask: i64 = 0
                var mk = 0.0
                var md = 0.0
                var mb = 0.0
                var bf = 0.0
                if nk > 0 { mask = mask | 1; mk = ks / (nk as f64) }
                if nd > 0 { mask = mask | 2; md = ds / (nd as f64); mask = mask | 8 }
                if nb > 0 { mask = mask | 4; mb = bs / (nb as f64); mask = mask | 16; bf = (bneg as f64) / (nb as f64) }
                atlas_push(out, cy, cs, cd, storm, nk, mask, mk, md, mb, dmin, bf)
            }
            open = true
            cy = ymd.y
            cs = ymd.m
            cd = ymd.d
            nk = 0
            ks = 0.0
            storm = 0
            nd = 0
            ds = 0.0
            dmin = 0.0
            nb = 0
            bs = 0.0
            bneg = 0
        }
        if omni_valid(o, col_kp(), i) {
            let x = omni_get(o, col_kp(), i)
            nk = nk + 1
            ks = ks + x
            if x >= 5.0 { storm = storm + 1 }
        }
        if omni_valid(o, col_dst(), i) {
            let x = omni_get(o, col_dst(), i)
            if nd == 0 || x < dmin { dmin = x }
            nd = nd + 1
            ds = ds + x
        }
        if omni_valid(o, col_bz(), i) {
            let x = omni_get(o, col_bz(), i)
            nb = nb + 1
            bs = bs + x
            if x < 0.0 { bneg = bneg + 1 }
        }
        i = i + 1
    }
    if open {
        var mask: i64 = 0
        var mk = 0.0
        var md = 0.0
        var mb = 0.0
        var bf = 0.0
        if nk > 0 { mask = mask | 1; mk = ks / (nk as f64) }
        if nd > 0 { mask = mask | 2; md = ds / (nd as f64); mask = mask | 8 }
        if nb > 0 { mask = mask | 4; mb = bs / (nb as f64); mask = mask | 16; bf = (bneg as f64) / (nb as f64) }
        atlas_push(out, cy, cs, cd, storm, nk, mask, mk, md, mb, dmin, bf)
    }
}
