// Testes de sio/omni.sio sobre tests/fixtures/omni2/sample.dat (escrito a mao).
use num::{days_from_civil}
use omni::{Omni, omni_new, omni_append_file, omni_valid, omni_get, omni_t, omni_print_summary, omni_count_lines, col_bx, col_bz, col_n, col_v, col_p, col_kp, col_dst}

fn near(a: f64, b: f64) -> bool {
    let d = if a > b { a - b } else { b - a }
    d <= 1.0e-12
}

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    let path = "tests/fixtures/omni2/sample.dat"
    let cap = omni_count_lines(path)
    var o = omni_new(cap)
    let added = omni_append_file(&!o, path)
    // 8 linhas: 6 registros, 1 linha curta (bad), 1 em branco
    assert(added == 6)
    assert(o.n == 6)
    assert(o.bad == 1)
    // tempos (UTC): 2024-01-01T00:00, ..., 2024-12-31T23:00 (doy 366), 2020-02-29T12:00
    assert(omni_t(&o, 0) == days_from_civil(2024, 1, 1) * 86400)
    assert(omni_t(&o, 1) == days_from_civil(2024, 1, 1) * 86400 + 3600)
    assert(omni_t(&o, 4) == days_from_civil(2024, 12, 31) * 86400 + 23 * 3600)
    assert(omni_t(&o, 5) == days_from_civil(2020, 2, 29) * 86400 + 12 * 3600)
    // Kp / 10 na leitura
    assert(omni_valid(&o, col_kp(), 0) && near(omni_get(&o, col_kp(), 0), 2.7))
    assert(near(omni_get(&o, col_kp(), 1), 3.0))
    assert(near(omni_get(&o, col_kp(), 4), 9.0))
    // linha 3 (indice 2): todos os campos em fill -> AUSENTE (nunca 0)
    var c: i64 = 0
    while c < 8 {
        assert(!omni_valid(&o, c, 2))
        c = c + 1
    }
    // Kp real 0.0 e DADO (nao e ausente)
    assert(omni_valid(&o, col_kp(), 3))
    assert(omni_get(&o, col_kp(), 3) == 0.0)
    assert(near(omni_get(&o, col_dst(), 3), -78.0))
    assert(near(omni_get(&o, col_bz(), 3), -8.8))
    assert(near(omni_get(&o, col_n(), 3), 12.5))
    assert(near(omni_get(&o, col_v(), 3), 650.0))
    assert(near(omni_get(&o, col_p(), 3), 7.30))
    assert(near(omni_get(&o, col_bx(), 0), -1.5))
    omni_print_summary(&o)
    print("OMNI_FIXTURE_OK\n")
    return 0
}
